# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ehci_pci"
    "ahci"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # Root is an LV inside the LUKS container on the SSD, opened as `cryptroot` in
  # the initrd -- see boot.initrd.luks.devices in ./default.nix. The swap LV
  # below shares that container, so it is encrypted without a second prompt.
  fileSystems."/" = {
    device = "/dev/vg-pond/root";
    fsType = "ext4";
  };

  # The ESP. Addressed by GPT partition label because that is set at partition
  # time and so could be written into the config before the disk existed; see
  # the note in ./default.nix. Holds unencrypted kernels and initrds, hence
  # root-only.
  fileSystems."/boot" = {
    device = "/dev/disk/by-partlabel/ESP";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  # /home is an ext4 inside a LUKS2 container sitting directly on the md array.
  # No partition table in between: the old layout had a DOS table on the md
  # device (md127p1) which did nothing except cap it at MBR's 2 TiB.
  #
  # Unlocked as `crypthome` in stage 2 from a keyfile on root -- see
  # environment.etc.crypttab in ./default.nix -- so the only passphrase prompt
  # at boot is root's own. The explicit requires makes a failed unlock fail the
  # mount immediately instead of waiting out the 90s device timeout.
  fileSystems."/home" = {
    device = "/dev/mapper/crypthome";
    fsType = "ext4";
    options = [ "x-systemd.requires=systemd-cryptsetup@crypthome.service" ];
  };

  swapDevices = [
    {
      device = "/dev/vg-pond/swap";
    }
  ];

  nix.settings.max-jobs = lib.mkDefault 8;
  powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";
}
